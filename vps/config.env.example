# daily-trend-radar/deliver.py の設定ファイル(例)。
# 実際に使うときは /etc/daily-trend-radar/config.env にコピーして値を埋める。
# 値は空のまま。パーミッションは600にすること(INSTALL.md参照)。

LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
LINE_PING_URL=

# 以下は省略時デフォルトあり。変える必要が無ければ空のままでよい。
# REPORT_JSON_URL=https://raw.githubusercontent.com/nynyzeni-dot/daily-trend-radar/main/latest.json
# STATE_FILE=/var/lib/daily-trend-radar/last_delivered.txt

# --- weekly_youtube.py用(同じconfig.envを共用する) ---
YOUTUBE_API_KEY=

# 以下は省略時デフォルトあり。変える必要が無ければ空のままでよい。
# YOUTUBE_STATE_FILE=/var/lib/daily-trend-radar/last_youtube.txt
